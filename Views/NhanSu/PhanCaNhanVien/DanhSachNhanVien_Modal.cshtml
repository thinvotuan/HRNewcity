@using BatDongSan.Models.NhanSu
@{
    ViewBag.Title = "Index";
    Layout = null;
    Layout = "~/Views/Shared/_Popup.cshtml";
   
}
<script type="text/javascript" src="~/Scripts/Jquery.treeview/jquery.treeview.js"></script>
<link rel="stylesheet" href="~/Scripts/Jquery.treeview/jquery.treeview.css" />

<script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/additional-methods.min.js"></script>
<script src="~/Scripts/autoNumeric.js"></script>
<script src="~/Scripts/batdongsan.validate.js"></script>
<script src="~/Scripts/moment.min.js"></script>
<script src="~/Scripts/vi.js"></script>
<script src="~/Scripts/bootstrap-datetimepicker.min.js"></script>
<link rel="stylesheet" href="~/Content/bootstrap-datetimepicker.min.css" />
<link rel="stylesheet" href="~/Content/summernote/summernote.css" />
<script src="~/Content/summernote/summernote.js"></script>
<script src="/Scripts/autoNumeric.js"></script>



<script type="text/javascript">
    var obj = window.opener;
    $().ready(function () {
        $(".datepicker").datetimepicker({
            locale: 'vi',
            format: 'DD/MM/YYYY'
        });

        $("#tuNgay_CDCTG").data("DateTimePicker").date(moment());
        To3Month_CDCTG();

        $(".numberinput").autoNumeric('init', { mDec: 0, mNum: 3, lZero: 'deny', aSep: ',', aDec: '.', pSign: 's', vMin: '0' });

        $('#checkAll').click(function (e) {
            $('[name="chk"]').prop('checked', this.checked);
        });

        $('[name="chk"]').click(function (e) {
            if ($('[name="chk"]:checked').length == $('[name="chk"]').length || !this.checked)
                $('#checkAll').prop('checked', this.checked);
        });
        $("#navigation1").treeview({
            persist: "location",
            collapsed: false,
            unique: false
        });
        var parentId = "";
        //Khoi tao
        var giatri = $("#navigation1 li:nth-child(1) a").attr("alt");
        var qsearch = $("#searchText").val().replace(/ /gi, '+');

        var url = '@Url.Action("LoadNhanVienTNK", "PhanCaNhanVien")' + "?parrentId=" + giatri.trim() + "&_page=1" + '&qSearch=' + qsearch;
        var imageUrl = '<div id="divMsg" align="center"><img src="@Url.Content("~/Content/Images/loading.gif") "/></div>';
        $('#tbody').html(imageUrl);
        $('#tbody').load(url, function () {
        });
        //End khoi tao
        //khi click vào công viêc tren tree
        $("#navigation1 a").click(function () {
            $.each($("#navigation1 a"), function () {
                $(this).css("color", "");
            });
            $(this).css("color", "red");
            parentId = $(this).attr("alt");

            // Get phòng ban
            var giatri = $(this).attr("alt").replace(/ /gi, '+');
            var qsearch = $("#searchText").val().replace(/ /gi, '+');

            var url = '@Url.Action("LoadNhanVienTNK", "PhanCaNhanVien")' + "?parrentId=" + giatri.trim() + "&_page=1" + '&qSearch=' + qsearch;
            var imageUrl = '<div id="divMsg" align="center"><img src="@Url.Content("~/Content/Images/loading.gif") "/></div>';
            $('#tbody').html(imageUrl);
            $('#tbody').load(url, function () {
            });
        });
        $('#btnSearch').click(function () {
            Search();
        });

        $("#searchText").keyup(function (e) {
            if (event.keyCode == 13) {
                Search();
            }
        });

        $(".numberinput").autoNumeric('init', { mDec: 0, mNum: 3, lZero: 'deny', aSep: ',', aDec: '.', pSign: 's', vMin: '-1000' });
    });

    function OnCriteriaPC(page) {
        var giatri = $("#parrentId").val().replace(/ /gi, '+');
        var qsearch = $("#searchText").val().replace(/ /gi, '+');
        var url = '@Url.Action("LoadNhanVienTNK", "PhanCaNhanVien")' + "?parrentId=" + giatri.trim() + "&_page=" + page + '&qSearch=' + qsearch;
        var imageUrl = '<div id="divMsg" align="center"><img src="@Url.Content("~/Content/Images/loading.gif") "/></div>';
        $('#tbody').html(imageUrl);
        $('#tbody').load(url, function () {
        });
    }

    function Search() {
        var giatri = $("#parrentId").val().replace(/ /gi, '+');
        var qsearch = $("#searchText").val().replace(/ /gi, '+');
        var url = '@Url.Action("LoadNhanVienTNK", "PhanCaNhanVien")' + "?parrentId=" + giatri.trim() + "&_page=1" + '&qSearch=' + qsearch;
        var imageUrl = '<div id="divMsg" align="center"><img src="@Url.Content("~/Content/Images/loading.gif") "/></div>';
        $('#tbody').html(imageUrl);
        $('#tbody').load(url, function () {
        });
    }

    var maNhanVien_CDCTG, hoVaTen_CDCTG, departmentId_CDCTG, phongBan_CDCTG, chucDanh_CDCTG;

    function ChonNVCheDoCongThemGio(maNhanVien, hoVaTen, departmentId, phongBan, chucDanh) {

        maNhanVien_CDCTG = maNhanVien;
        hoVaTen_CDCTG = hoVaTen;
        departmentId_CDCTG = departmentId;
        phongBan_CDCTG = phongBan;
        chucDanh_CDCTG = chucDanh;

        $("#title_CDCTG").html("Nhập thông tin cho nhân viên : <span style='color:blue;font-weight:bold;'> " + hoVaTen + "<span/>");

        $('#myModalChonNhanVienCheDoCongThemGio').modal();
    }



    function Action_ChonNhanVienCheDoCongThemGio() {
        if ($("#soPhut_CDCTG").val() == "" || $("#soPhut_CDCTG").val() == "0") {
            Alert.error("Vui lòng nhập vào số phút.", "Thông báo", { displayDuration: 2000 });
            return;
        }

        bootbox.confirm({
            title: "Thông báo.!",
            message: "Bạn có muốn thêm nhân viên này?",
            buttons: {
                cancel: {
                    label: '<i class="fa fa-times"></i> Cancel'
                },
                confirm: {
                    label: '<i class="fa fa-check"></i> Confirm'
                }
            },
            callback: function (result) {
                if (result) {
                    var url = "@Url.Action("ThemNhanVienThuocCheDoCongThemGio", "PhanCaNhanVien")";
                    $.ajax({
                        type: "POST",
                        url: url,
                        data: {
                            'maNhanVien': maNhanVien_CDCTG.trim()
                            , 'hoVaTen': hoVaTen_CDCTG.trim()
                            , 'departmentId': departmentId_CDCTG.trim()
                            , 'phongBan': phongBan_CDCTG.trim()
                            , 'chucDanh': chucDanh_CDCTG.trim()
                            , 'soPhut': $("#soPhut_CDCTG").val()
                            , 'tuNgay': $("#tuNgay_CDCTG").val()
                            , 'denNgay': $("#denNgay_CDCTG").val()
                        },
                        success: function (result) {
                            if (result == '') {
                                Alert.success("Thêm thành công", "Thông báo", { displayDuration: 2000 });
                                obj.SearchTC_Tab3();
                                $('#myModalChonNhanVienCheDoCongThemGio').modal('toggle');
                            }
                            else {
                                Alert.success(result, "Thông báo", { displayDuration: 2000 });
                            }
                        }
                    });
                }
            }
        });
    }

    function To3Month_CDCTG() {
        //$("#tuNgay_CDCTG").data("DateTimePicker").date(moment());
        $("#denNgay_CDCTG").data("DateTimePicker").date(moment().subtract(-3, "month"));
    }

    function To6Month_CDCTG() {
        //$("#tuNgay_CDCTG").data("DateTimePicker").date(moment());
        $("#denNgay_CDCTG").data("DateTimePicker").date(moment().subtract(-6, "month"));
    }

</script>

<style>
    .pageActive, .pageCurrent:hover, .pageNext:hover, .pageLast:hover, .pageFirst:hover, .pagePrevious:hover {
        padding: 7px 11px;
        background-color: #4D8AFF;
        color: #FFFFFF;
        display: inline-block;
        border: 1px solid #80ABFF;
        border-radius: 20px;
        text-decoration: none;
        font-weight: bold;
    }

    .pageCurrent, .pageNext, .pageLast, .pageFirst, .pagePrevious {
        padding: 7px 11px;
        background-color: #fff;
        display: inline-block;
        border: 1px solid #80ABFF;
        border-radius: 20px;
        font-weight: bold;
    }

    #Avatar {
        width: 100%;
        height: auto;
        max-width: 50px;
        object-fit: cover;
    }

    #imgInp {
        opacity: 0;
        height: 100%;
        width: 100%;
        bottom: 0;
        cursor: pointer;
        position: absolute;
        margin: 0;
        padding: 0;
        right: 0;
    }
</style>
<div id="container">



    <table width="100%" cellpadding="2" border="0" cellspacing="0">
        <tr>
            <td style="width: 30%" valign="top">
                <fieldset class="removeBorderFieldset">

                    <div id="tabs" style="" class="ui-tabs">
                        <ul class="ui-tabs-nav">
                            <li class="ui-tabs-selected ui-state-active"><a><span>Danh mục bộ phận</span></a></li>
                        </ul>
                    </div>
                    <div style="height: 90%; max-height: 400px; overflow: auto; margin-left: 30px" id="divTreeCongViec">@Html.Raw(ViewBag.departments)</div>
                </fieldset>
            </td>
            <td valign="top" style="width: 70%">
                <fieldset class="removeBorderFieldset">
                    <div id="tabs" style="" class="ui-tabs">
                        <ul class="ui-tabs-nav">
                            <li class="ui-tabs-selected ui-state-active"><a><span>Danh sách nhân viên</span></a></li>
                        </ul>
                    </div>

                    <div style="padding: 5px; overflow: hidden; background: #ddd;">




                        <div class="input-group" style="max-width: 350px; float: left;">

                            <input type="text" id="searchText" placeholder="Nhập mã hoặc tên" name="searchText" value="@ViewBag.qSearch" class="form-control"/>
                            <span class="input-group-btn">
                                <button class="btn btn-default" type="button" id="btnSearch">Tìm kiếm</button>

                            </span>
                        </div>
                        <!-- /input-group -->
                        @*<input type="button"  class="btn btn-default btnChon" value="Chọn" onclick="ChonNhanViens()" style="float:right"/>*@
                        @*<input type="button" class="btn btn-default btnChon" value="Chọn" onclick="ChonNV()" style="float: right" />*@
                    </div>
                    <table id="gridSource" width="100%" class="tbl colorize table table-striped table-hover table-condensed">
                        <thead>
                            <tr class="background_tr">
                                <th style="width: 30px;">STT
                                </th>
                                <th style="width: 100px;">Hình ảnh
                                </th>
                                <th style="width: 250px;">Nhân viên
                                </th>
                                <th style="width: 250px;">Phòng ban
                                </th>
                                <th style="width: 250px;">Chức danh
                                </th>
                                <th></th>
                                @*<th style="width: 30px;">
                                    <input type="checkbox" id="checkAll" name="checkAll" title="Click chọn tất cả." onclick="checkAllTbl('gridSource', 'checkAll')" />
                                </th>*@
                            </tr>
                        </thead>
                        <tbody id="tbody">@{Html.RenderPartial("LoadNhanVien");}</tbody>
                    </table>
                </fieldset>
            </td>
        </tr>
    </table>
    <div id="myModalChonNhanVienCheDoCongThemGio" class="modal fade" role="dialog">
        <div class="modal-dialog modal-lg">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" id="title_CDCTG"></h4>
                </div>
                <div class="modal-body">

                    <div class="container" style="width: 98%">
                        <div class="row">
                            <table class="tbl colorize table table-striped table-hover table-condensed;width : 100%;">

                                <tr>
                                    <td>Số phút : 
                                    </td>
                                    <td>
                                        <input type="text" class="numberinput" style="width: 50%; text-align: right;" id="soPhut_CDCTG" value="0"/>(phút)
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2">
                                        <span style="float: left;">Từ ngày :</span>
                                        <input type="text" id="tuNgay_CDCTG" class="form-control datepicker" placeholder="Từ ngày" style="width: 80px; float: left; margin-right: 5px" />
                                        <span style="float: left;">Đến ngày :</span>
                                        <input type="text" id="denNgay_CDCTG" class="form-control datepicker" placeholder="Đến ngày" style="width: 80px; float: left; margin-right: 5px" />
                                        <a href="javascript:void(0)" onclick="To3Month_CDCTG()"><i class="fa fa-calendar" aria-hidden="true"></i>3 tháng</a> <a href="javascript:void(0)" onclick="To6Month_CDCTG()"><i class="fa fa-calendar" aria-hidden="true"></i>6 tháng</a>
                                    </td>

                                </tr>
                            </table>
                            <div style="float: right; margin-top: 10px;">
                                <button class="btn btn-info" type="button" data-dismiss="modal" aria-label="Close">Đóng</button>
                                <button class="btn btn-info" type="button" onclick="Action_ChonNhanVienCheDoCongThemGio();">Chọn</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                </div>
            </div>

        </div>
    </div>
</div>

